@using TietoCRM.Models;
@using System.Web.Script.Serialization

<div class="col-md-12">

    <input type="text" data-name="TopTitle" disabled style="margin-bottom:20px" id="top-title-text" class="form-control main-template-mainhead" value="SaaS Formula" />

    <div class="form-group">
        <div class="col-sm-12" style="margin-bottom:20px;">
            <div class="checkbox">
                <label for="activate-saas-formula" class="col-sm-12">
                    <input id="activate-saas-formula" data-id="activate-saas-formula" name="ActivateSaasFormulaFunction" type="checkbox" />
                    Activate SaaS Formula function
                </label>
            </div>
        </div>
        <div class="col-sm-4" style="display: flex; align-items: center;">
            <label for="license" class="control-label mb-0" style="margin-right:10px">( License / </label>
            <input type="number" class="form-control mx-1" name="license" id="license" style="width: 80px; margin-right: 10px; height: 30px;">
            <label for="factor" class="control-label mb-0" style="margin-right:10px">+ Maintenance ) * </label>
            <input type="number" class="form-control mx-1" name="factor" id="factor" style="width: 80px; height: 30px;">
        </div>
        <div class="col-sm-12 control-label" style="top:20px;">
            <label class="control-label mb-0" style="margin-right:10px"> Ex. ( License / Number of months + Maintenance ) * Multiplication factor</label>
        </div>
    </div>

    <div class="form-inline">
        <button class="btn btn-success" type="button" style="float:right; margin-bottom: 10px;" id="save-button">Save</button>
    </div>
</div>

<script>
    var serverPrefix = "@Url.Content("~/")";

    $(document).ready(function () {
        $("#license").val(@ViewBag.SaasFormula.LicensePart.ToString(System.Globalization.CultureInfo.InvariantCulture));
        $("#factor").val(@ViewBag.SaasFormula.Factor.ToString(System.Globalization.CultureInfo.InvariantCulture));

        if (@(ViewBag.SaasFormula.IsActive.ToString().ToLower())) {
            document.getElementById("activate-saas-formula").checked = true;
        } else {
            setupCheckbox();
        }

    });

    $("#activate-saas-formula").click(function () {
        setupCheckbox();
    })

    function setupCheckbox() {
        const activate = document.getElementById("activate-saas-formula");
        if (activate.checked) {
            $("#license").prop("disabled", false);
            $("#factor").prop("disabled", false);
        } else {
            $("#license").prop("disabled", true);
            $("#factor").prop("disabled", true);
        }
    }

    $("#save-button").click(function () {
        //var list = [];

        //$.each($(".form-control"), function (index, element) {
        //    $element = $(element);

        //    list.push({ name: $element.attr("data-name"), value: $element.val() });
        //});
        var data =
        {
            "license": $("#license").val(),
            "factor": $("#factor").val(),
            "activate": document.getElementById("activate-saas-formula").checked
        };

        $.ajax({
            "url": serverPrefix + "SaasFormula/SaveSaasFormula/",
            "type": "POST",
            "data": data,
            success: function (data) {
                if (data > 0) {
                    console.log("Sucsess");

                    $(document).trigger("clear-alerts");
                    $(document).trigger("add-alerts", [
                        {
                            'message': "Successfully updated values",
                            'priority': 'success'
                        }
                    ]);
                }
                else {
                    $(document).trigger("clear-alerts");
                    $(document).trigger("add-alerts", [
                        {
                            'message': "Something went wrong when trying to update, some data might not been saved",
                            'priority': 'warning'
                        }
                    ]);
                }
            }
        });
    });

</script>
