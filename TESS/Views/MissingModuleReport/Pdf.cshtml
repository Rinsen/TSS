@{
    Layout = "~/Views/Shared/_ReportLayout.cshtml";
    bool showDesc = false;
    if (Request.Params["showDesc"] != null) {
        if(Request.Params["showDesc"] == "1"){
            showDesc = true;
        }
    }
    string oldModule = "";
}

<div class="crm-print-block">
    @{
        var handledModules = new List<string>();
    }
    @foreach (var module in ViewBag.Modules)
    {
        if (!handledModules.Contains(module.Module))
        {
            handledModules.Add(module.Module);
            <h2>@module.Article_number - @module.Module</h2>

            <table class="table table-striped table-bordered contract-supervision-table">
                <th>Customer</th>
                <th style="width: 15em">Module</th>
                <th style="width: 15em">Representative</th>
                <th>Classification</th>
                @foreach (TietoCRM.Models.MissingModuleReportRow row in ViewBag.Modules)
                {
                    if (row.Module == module.Module)
                    {
                        <tr class="" style="page-break-inside:avoid">
                            <td>@row.Customer</td>
                            <td>@row.Module</td>
                            <td>@row.Representative</td>
                            <td>@row.Classification</td>
                        </tr>
                    }
                }
            </table>
        }
    }
</div>


