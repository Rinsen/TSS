@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using TietoCRM.Extensions;
<row>
    <div class="col-md-12">
        <form id="customer-select-form" method="get" action="~/SalesmanHashtagReport/Pdf" target="_blank" class="form-inline">
            <div class="form-group">
                <label for="crm-select-user">Representative:</label>
                <select name="user" id="crm-select-user" multiple class="form-control selectpicker" data-show-subtext="true" data-live-search="true">
                    @foreach (TietoCRM.Models.view_User User in ViewBag.Users)
                    {
                        <option value="@User.Sign">@User.Name</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <div class="checkbox" style="margin-top: 1.7em; margin-left: 0.5em; margin-right:0.5em;">
                    <label>
                        <input type="checkbox" id="search-offers">Offers
                    </label>
                    <br>
                    <label>
                        <input type="checkbox" id="search-contracts">Contracts
                    </label>
                </div>
            </div>
            <button id="search-button" style="margin-top: 1.7em;" class="btn btn-default" type="button">Search</button>
            <button id="fetch-pdf" style="margin-top: 1.7em;" class="btn btn-default" type="button">PDF</button>
        </form>
    </div>
    <div class="col-md-12">
        <table draggable="true" id="report-table" class="table table-bordered table-hover" data-sort-name="name" data-sort-order="desc">
            <thead>
                <tr>
                    @foreach (System.Reflection.PropertyInfo PropertyInfo in ViewBag.Properties)
                    {
                        String PropertyName = PropertyInfo.Name.Replace("_", " ");
                        if (!ViewBag.IgnoredProperties.Contains(PropertyInfo.Name))
                        {
                            <th data-field="@PropertyInfo.Name" data-sortable="true">@PropertyName</th>
                        }
                    }
                </tr>
            </thead>
        </table>
    </div>
<script>
    var serverPrefix = "@Url.Content("~/")";
    @{String DataObject = "\r\n";}
    @foreach (System.Reflection.PropertyInfo PropertyInfo in ViewBag.Properties)
    {
        String PropertyName = PropertyInfo.Name.Replace("_", " ");
        if (!ViewBag.IgnoredProperties.Contains(PropertyInfo.Name))
        {
            DataObject += "\t\t\t\t\t\t\t\t\t\t\t{ \"data\": \"" + @PropertyInfo.Name + "\"  },\r\n";
        }
    }
    @{DataObject = DataObject.Remove(DataObject.Length - 3);}
    var updateDataTable = function(user)
    {
        var isOffer = $('#search-offers').is(':checked')
        var isContract = $('#search-contracts').is(':checked')

        $('#report-table').DataTable({
            "destroy": true,
            "processing": true,
            "bFilter": false,
            "bPaginate": false,
            //"bSort": false, //Enable to get data table sortable
            "ajax": {
                "url": serverPrefix + "SalesmanHashtagReport/GetUserHashtags/",
                "type": "POST",
                "data": {
                    "user": user,
                    "contract": isContract,
                    "offer": isOffer
                }
            },
            "defaultContent": "",
            "order": [], //  We fix order on server... Classification-SortNo order //3 is column order in dt, in this case "System"
            //"order": [[2, 'asc'], [3, 'asc'], [1, 'asc']],
            "columns": [@Html.Raw(DataObject)
            ],

            "scrollX": true,

        });

    }
    $('document').ready(function () {

        $('.selectpicker').selectpicker();

        $userContainer = $("#crm-select-user");

        updateDataTable('');

        $userContainer.change(function () {
            updateDataTable(JSON.stringify($userContainer.val()));
        });

        $('#search-button').click(function () {
            updateDataTable(JSON.stringify($userContainer.val()));
        });

        $('#fetch-pdf').click(function () {
            var user = $userContainer.val();
            var isOffer = $('#search-offers').is(':checked')
            var isContract = $('#search-contracts').is(':checked')

            var $dt = $('.dataTable').DataTable();
            var sortArr = $dt.order();
            var sort = "";
            if (sortArr.length > 0) {
                sort = "&sort=" + sortArr[0][1] + "&prop=" + $($dt.columns(sortArr[0][0]).header()).attr("data-field");
            } else {
                sort = "&sort=&prop=";
            }

            window.open(serverPrefix + 'SalesmanHashtagReport/Pdf?user=' + user + '&isOffer=' + isOffer + '&isContract=' + isContract + sort, "_blank");
        });

        $('#export-excel').click(function () {
            var customer = $customerContainer.val();
            var user = $userContainer.val();
            var exp = "Ja"
            var $dt = $('.dataTable').DataTable();
            var sortArr = $dt.order();
            var sort = "";
            if (sortArr.length > 0) {
                sort = "&sort=" + sortArr[0][1] + "&prop=" + $($dt.columns(sortArr[0][0]).header()).attr("data-field");
            } else {
                sort = "&sort=&prop=";
            }
            if ($('#expired').is(':checked')) {
                exp = "Nej"
            }
            window.open(serverPrefix + 'SalesmanHashtagReport/ExportExcel?customer=' + customer + '&expired=' + exp + '&user=' + user + sort, "_parent").focus();
        });
    });

</script>
</row>
